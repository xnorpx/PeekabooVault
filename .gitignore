# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Node.js / npm / pnpm / yarn
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# SvelteKit
.svelte-kit/

# Vite
dist/
dist-ssr/
.vite/

# TypeScript
*.tsbuildinfo

# Build outputs
build/
out/
.output/

# Environment files (may contain secrets)
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Reference implementations (checked out for design inspiration)
# TODO: Remove these from .gitignore once we no longer need them locally
# These are external projects used as architectural references - see DESIGN.md
blue-onyx/
frigate/
moonfire-nvr/
scrypted/
